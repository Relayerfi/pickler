{
  "name": "pickler-monorepo",
  "private": true,
  "packageManager": "npm@10.9.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@pickler/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint .",
    "test": "npm run build:shared && node --import tsx --test packages/core/test/*.test.ts packages/infrastructure/test/*.test.ts apps/agent-service/test/*.test.ts",
    "contracts:build": "forge build --root contracts",
    "contracts:test": "forge test --root contracts",
    "dev:agent": "npm run build:shared && npm run dev --workspace=@pickler/agent-service",
    "build:shared": "turbo run build --filter=@pickler/core --filter=@pickler/infrastructure --filter=@pickler/api-schema",
    "agent": "npm run cli --workspace=@pickler/agent-service --"
  },
  "devDependencies": {
    "turbo": "^2.10.13",
    "typescript": "^6.0.3",
    "tsx": "^4.23.13",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
